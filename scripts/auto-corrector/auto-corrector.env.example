# Auto-Corrector Environment Configuration
# Copy this file to .env.local and fill in your actual values

# GitHub Configuration
GITHUB_TOKEN=
GITHUB_REPO_URL=

# Vercel Configuration
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Local Configuration (Optional)
LOCAL_REPO_PATH=./temp-repo
MONOREPO_PATH=agents

# Project Mappings (Optional)
# Map GitHub project paths to Vercel project names/IDs when they differ
# Format: JSON object with GitHub paths as keys and Vercel names/IDs as values
# You can use either project names or project IDs (starting with prj_)
PROJECT_MAPPINGS={"test-for-ai-corrector":"prj_45ZhRtVymW2OOFSQdFi1CIePCyOB"}

# Instructions:
# 1. GITHUB_TOKEN: Create a personal access token at https://github.com/settings/tokens
#    Required scopes: repo, workflow
#
# 2. VERCEL_API_TOKEN: Get your token from https://vercel.com/account/tokens
#    Make sure the token has access to your team/organization
#
# 3. VERCEL_TEAM_ID: Find your team ID in Vercel dashboard settings
#    Go to Settings > General and copy the Team ID
#    For personal accounts, you can also find this in the URL: vercel.com/[team-id]/...
#
# 4. OPENAI_API_KEY: Get your API key from https://platform.openai.com/api-keys
#
# 5. LOCAL_REPO_PATH: Local directory where the repository will be cloned (optional)
#
# 6. MONOREPO_PATH: Path within the repository where agent projects are stored (optional)
#
# 7. PROJECT_MAPPINGS: Map GitHub project paths to Vercel project names/IDs (optional)
#    Use this when your GitHub project structure doesn't match Vercel project names
#    You can use either project names or project IDs (IDs start with prj_)
#    Examples:
#    - By name: {"my-github-folder":"my-vercel-project"}
#    - By ID: {"my-github-folder":"prj_ABC123DEF456"}
#    - Multiple mappings: {"agent-001":"prod-app","agent-002":"prj_XYZ789","docs":"documentation-site"}
#
# Troubleshooting:
# - If you get 403 errors, check that your VERCEL_API_TOKEN has the right permissions
# - If you get "project not found" errors, verify your VERCEL_TEAM_ID is correct
# - For project IDs, you can find them in the Vercel dashboard URL or via the API
#
# Usage Examples:
# - Same names: npx tsx scripts/auto-corrector.ts --project my-project
# - Different names: npx tsx scripts/auto-corrector.ts --github-project agent-001 --vercel-project my-vercel-app
# - Using project IDs: npx tsx scripts/auto-corrector.ts --github-project agent-001 --vercel-project prj_ABC123DEF456
# - Using mappings: Set PROJECT_MAPPINGS and use --project agent-001 (will auto-resolve to mapped Vercel name/ID) 