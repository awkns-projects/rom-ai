# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Get your xAI API Key here for chat and image models: https://console.x.ai/
XAI_API_KEY=****

# Get your OpenAI API Key here: https://platform.openai.com/api-keys
OPENAI_API_KEY=****

# AI Provider Selection: 'xai' or 'openai' (defaults to 'xai')
AI_PROVIDER=xai

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****

# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Get your Neon API Key here for database deployment: https://console.neon.tech/app/settings/api-keys
# Required for Step 4 deployment functionality
NEON_API_KEY=****

# Get your Vercel API Token here for deployment: https://vercel.com/account/tokens
# Required for Step 4 deployment functionality
VERCEL_TOKEN=****

# For google auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URL=
NEXT_PUBLIC_GOOGLE_REDIRECT_SCOPE=

# For x auth
NEXT_PUBLIC_X_CLIENT_ID=
NEXT_PUBLIC_X_REDIRECT_URI=
NEXT_PUBLIC_X_REDIRECT_URI=
NEXT_PUBLIC_X_SCOPE=

# For Facebook auth
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_REDIRECT_URI=
NEXT_PUBLIC_FACEBOOK_SCOPE=
NEXT_PUBLIC_FACEBOOK_FIELDS=

# For Instagram auth
NEXT_PUBLIC_INSTAGRAM_APP_ID=
NEXT_PUBLIC_INSTAGRAM_APP_SECRET=
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=
NEXT_PUBLIC_INSTAGRAM_SCOPE=
NEXT_PUBLIC_INSTAGRAM_FIELDS=

# For Threads auth
NEXT_PUBLIC_THREADS_APP_ID=
NEXT_PUBLIC_THREADS_APP_SECRET=
NEXT_PUBLIC_THREADS_REDIRECT_URI=
NEXT_PUBLIC_THREADS_SCOPE=
NEXT_PUBLIC_THREADS_FIELDS=

# For shopify auth
NEXT_PUBLIC_SHOPIFY_API_KEY=
NEXT_PUBLIC_SHOPIFY_API_SECRET=
NEXT_PUBLIC_SHOPIFY_REDIRECT_URI=
NEXT_PUBLIC_SHOPIFY_SHOP_NAME=
NEXT_PUBLIC_SHOPIFY_SCOPE=